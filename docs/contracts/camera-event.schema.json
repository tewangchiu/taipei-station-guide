{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sanitized anchor progress event; no timestamps or device/session identifiers",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "nodeId": {
      "enum": [
        "Y28",
        "Y26",
        "Y23"
      ]
    },
    "type": {
      "const": "anchor_progressed"
    },
    "evidenceSource": {
      "enum": [
        "vision_experimental",
        "manual_fallback"
      ]
    },
    "inputSource": {
      "enum": [
        "camera",
        "replay"
      ]
    }
  },
  "required": [
    "sequence",
    "nodeId",
    "type",
    "evidenceSource",
    "inputSource"
  ],
  "$id": "camera-event.schema.json"
}
