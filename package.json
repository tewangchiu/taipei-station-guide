{
  "name": "taipei-station-guide",
  "version": "0.1.0",
  "private": true,
  "description": "Local camera-guidance prototype; private route assets are not distributed.",
  "scripts": {
    "start:camera": "node scripts/serve_camera_guidance.mjs",
    "start:manual-visual": "node scripts/serve_manual_visual.mjs",
    "prepare:camera": "node scripts/prepare_camera_prototype.mjs",
    "test": "node scripts/run_tests.mjs",
    "check": "node scripts/run_checks.mjs",
    "check:docs": "node scripts/check_docs.mjs",
    "check:repository": "node scripts/check_repository_hygiene.mjs",
    "setup:hooks": "git config --local core.hooksPath .githooks"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10 <12"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "ajv": "8.20.0"
  }
}
